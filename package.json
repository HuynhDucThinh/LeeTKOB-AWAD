{
  "name": "leetkob-pa2",
  "version": "0.1.0",
  "private": true,
  "description": "LeeTKOB PA#2 — Harness, Quality Gate & Transactional Lab Publishing Contract (Spring Boot 3 + Java 21)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node scripts/gradlew.mjs bootRun",
    "lint": "node scripts/gradlew.mjs --no-daemon checkstyleMain checkstyleTest",
    "format:check": "node scripts/gradlew.mjs --no-daemon spotlessCheck",
    "format": "node scripts/gradlew.mjs --no-daemon spotlessApply",
    "typecheck": "node scripts/gradlew.mjs --no-daemon testClasses",
    "test": "node scripts/gradlew.mjs --no-daemon test",
    "sec:scan": "node scripts/secret-scan.mjs",
    "check": "npm run sec:scan && npm run lint && npm run format:check && npm run typecheck && npm test"
  }
}
