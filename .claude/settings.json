{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run sec:scan)",
      "Bash(npm run check)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Edit(backend/pom.xml)",
      "Edit(package.json)",
      "Edit(.github/**)",
      "Edit(docs/contract/**)",
      "Edit(backend/src/main/resources/schema.sql)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh pr *)"
